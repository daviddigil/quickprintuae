# QuickPrint UAE — Powered by Nexsofture Tech
# ---------- core ----------
# PostgreSQL 14+ connection string
DATABASE_URL=postgres://qp:qp@localhost:5432/quickprint
# Public URL of the platform (used for payment return/webhook links)
APP_URL=http://localhost:3000
# Wildcard root domain. Shops are served at <slug>.ROOT_DOMAIN; custom domains are CNAMEd to it.
ROOT_DOMAIN=localhost:3000
# Session signing secret — generate with: openssl rand -hex 32  (REQUIRED in production)
AUTH_SECRET=
# Encrypts tenant payment/courier API keys and confidential uploads. Never change after go-live
# (existing secrets & confidential files become unreadable). openssl rand -hex 32  (REQUIRED in production)
ENCRYPTION_KEY=
# Where uploaded print files are stored (mount a persistent volume here)
UPLOAD_DIR=./.uploads

# ---------- AI ----------
# Enables the AI business card designer (Claude). Without it the designer falls back to templates.
ANTHROPIC_API_KEY=

# ---------- SaaS billing (platform's own Stripe account, charges print shops) ----------
PLATFORM_STRIPE_SECRET_KEY=
# Webhook endpoint: <APP_URL>/api/webhooks/platform-stripe  (events: checkout.session.completed, payment_intent.succeeded)
PLATFORM_STRIPE_WEBHOOK_SECRET=

# ---------- operations ----------
# Shared secret for cron endpoints, e.g. GET /api/v1/superadmin/cron/billing?secret=...
CRON_SECRET=
# Initial platform superadmin created by the seed script (change the password after first login)
SUPERADMIN_EMAIL=admin@quickprint.ae
SUPERADMIN_PASSWORD=change-me-now
# Create the "demo" store with sample logins. Set to false in production.
SEED_DEMO=true
# On a real domain (APP_URL not localhost) the demo shop is never created, SUPERADMIN_PASSWORD "change-me-now" is replaced by a random one (printed once in the first-start log),
# PAYMENTS_FAKE/DELIVERY_FAKE/WHATSAPP_FAKE are ignored unless ALLOW_FAKE_IN_PRODUCTION=1 (staging demos only), and the server refuses to start without strong
# CRON_SECRET, AUTH_SECRET and ENCRYPTION_KEY (24+ random characters). Cron callers must send  Authorization: Bearer $CRON_SECRET  (the ?secret= query is only accepted outside production).
# ALLOW_FAKE_IN_PRODUCTION=
# Simulate courier APIs (Jeebly/Quiqup/...) instead of calling them. Dev/staging only.
DELIVERY_FAKE=true
# Simulate Stripe checkout without keys (demo only — never in production)
PAYMENTS_FAKE=false

# ---------- docker / migrations ----------
# RUN_MIGRATIONS=true
# RUN_SEED=true

# --- AI banners (Nano Banana = Google Gemini image model) ---
# Get a key at https://aistudio.google.com/apikey . Without it, banners fall back to built-in templates.
GEMINI_API_KEY=
# gemini-2.5-flash-image = Nano Banana, gemini-3-pro-image-preview = Nano Banana Pro
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Free open-source image model (optional, tried before Nano Banana) ---
# Any server exposing OpenAI-compatible POST /v1/images/generations, running e.g. Qwen-Image (Apache-2.0).
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_API_MODEL=qwen-image

# --- WhatsApp Business coexistence + AI ordering (LIVE by default; set WHATSAPP_ENABLED=0 to switch off) ---
WHATSAPP_ENABLED=true
# Log outbound messages to the DB only, never call Meta (testing)
WHATSAPP_FAKE=false
# META_* are OPTIONAL fallbacks. Normally the superadmin pastes the Tech Provider credentials in
# Superadmin → Settings → WhatsApp Tech Provider (stored encrypted in the DB; the DB wins over these).
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_VERSION=v21.0
# Graph API base (leave empty for Meta; set to a mock server like http://localhost:4999 in tests)
META_GRAPH_BASE=
# AI replies use ANTHROPIC_API_KEY (above). Without it a built-in rule-based assistant answers.

# ---------- security (docs/SECURITY.md) ----------
# Superadmin MUST enrol 2FA in production (/superadmin/security). Set 0 ONLY for local/e2e production builds. Never in real production.
# REQUIRE_SUPERADMIN_2FA=0
# CSP: report-only by default. Set 1 AT BUILD TIME (docker build arg / before `next build`) to enforce.
# CSP_ENFORCE=1
# Rate limits are per instance (memory) unless one of these is set. REQUIRED when you run more than one app instance.
# REDIS_URL=redis://:password@host:6379/0        (rediss:// for TLS)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---------- email (password reset, verification decisions, payout and quote notices) ----------
# console = log only (default in dev/test; in production unset means "not configured" and nothing is sent)
# resend  = https://resend.com (RESEND_API_KEY + a sender on a domain verified there)
# smtp    = not built in (nodemailer is not a dependency)
EMAIL_PROVIDER=console
EMAIL_FROM="QuickPrint UAE <no-reply@quickprint.ae>"
RESEND_API_KEY=
# TEST ONLY (e2e): keep sent emails in memory and expose GET /api/v1/test/outbox. NEVER set in production.
# EMAIL_TEST_OUTBOX=1

# ---------- file storage ----------
# local (default) writes to UPLOAD_DIR. s3 = any S3-compatible bucket (AWS, Cloudflare R2, MinIO, Spaces, Wasabi), SigV4 signed.
# Confidential files stay AES-GCM encrypted by the app before upload.
STORAGE_DRIVER=local
# S3_ENDPOINT=https://s3.me-central-1.amazonaws.com
# S3_BUCKET=
# S3_REGION=me-central-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ADDRESSING=path          (or "virtual" for bucket.host style)

# ---------- diagnostics ----------
# Shown by /api/health (public-safe). Set in CI: APP_VERSION=$GIT_SHA
# APP_VERSION=
# Reserved for the Sentry integration plan in docs/GO_LIVE.md (not wired in code yet)
# SENTRY_DSN=

# ---------- uploads, malware scan and CAPTCHA (all optional; off when unset) ----------
# Upload limits are built in: 30 uploads / 10 min and 200 / day and 300 MB / day per IP + shop; images 25 MB, PDF 50 MB, office 25 MB, design files 50 MB.
# ClamAV clamd over TCP (INSTREAM). Unset = no scanning. CLAMAV_REQUIRED=1 refuses uploads when the scanner is unreachable (default: allow and log).
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_REQUIRED=0
# Cloudflare Turnstile on signup, quote form and AI card designer. Both unset = no CAPTCHA. The site key is public (browser); the secret stays on the server.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=   (NEXT_PUBLIC_* is inlined at build time: set it when running `next build`)
# TURNSTILE_SECRET_KEY=
