# QuickPrint UAE — Powered by Nexsofture Tech
# ---------- core ----------
# PostgreSQL 14+ connection string
DATABASE_URL=postgres://qp:qp@localhost:5432/quickprint
# Public URL of the platform (used for payment return/webhook links)
APP_URL=http://localhost:3000
# Wildcard root domain. Shops are served at <slug>.ROOT_DOMAIN; custom domains are CNAMEd to it.
ROOT_DOMAIN=localhost:3000
# Session signing secret — generate with: openssl rand -hex 32  (REQUIRED in production)
AUTH_SECRET=
# Encrypts tenant payment/courier API keys and confidential uploads. Never change after go-live
# (existing secrets & confidential files become unreadable). openssl rand -hex 32  (REQUIRED in production)
ENCRYPTION_KEY=
# Where uploaded print files are stored (mount a persistent volume here)
UPLOAD_DIR=./.uploads

# ---------- AI ----------
# Enables the AI business card designer (Claude). Without it the designer falls back to templates.
ANTHROPIC_API_KEY=

# ---------- SaaS billing (platform's own Stripe account, charges print shops) ----------
PLATFORM_STRIPE_SECRET_KEY=
# Webhook endpoint: <APP_URL>/api/webhooks/platform-stripe  (events: checkout.session.completed, payment_intent.succeeded)
PLATFORM_STRIPE_WEBHOOK_SECRET=

# ---------- operations ----------
# Shared secret for cron endpoints, e.g. GET /api/v1/superadmin/cron/billing?secret=...
CRON_SECRET=
# Initial platform superadmin created by the seed script (change the password after first login)
SUPERADMIN_EMAIL=admin@quickprint.ae
SUPERADMIN_PASSWORD=change-me-now
# Create the "demo" store with sample logins. Set to false in production.
SEED_DEMO=true
# Simulate courier APIs (Jeebly/Quiqup/...) instead of calling them. Dev/staging only.
DELIVERY_FAKE=true
# Simulate Stripe/Mamo checkout without keys (demo only — never in production)
PAYMENTS_FAKE=false

# ---------- docker / migrations ----------
# RUN_MIGRATIONS=true
# RUN_SEED=true

# --- AI banners (Nano Banana = Google Gemini image model) ---
# Get a key at https://aistudio.google.com/apikey . Without it, banners fall back to built-in templates.
GEMINI_API_KEY=
# gemini-2.5-flash-image = Nano Banana, gemini-3-pro-image-preview = Nano Banana Pro
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Free open-source image model (optional, tried before Nano Banana) ---
# Any server exposing OpenAI-compatible POST /v1/images/generations, running e.g. Qwen-Image (Apache-2.0).
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_API_MODEL=qwen-image

# --- WhatsApp Business coexistence + AI ordering (LIVE by default; set WHATSAPP_ENABLED=0 to switch off) ---
WHATSAPP_ENABLED=true
# Log outbound messages to the DB only, never call Meta (testing)
WHATSAPP_FAKE=false
# META_* are OPTIONAL fallbacks. Normally the superadmin pastes the Tech Provider credentials in
# Superadmin → Settings → WhatsApp Tech Provider (stored encrypted in the DB; the DB wins over these).
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_VERSION=v21.0
# Graph API base (leave empty for Meta; set to a mock server like http://localhost:4999 in tests)
META_GRAPH_BASE=
# AI replies use ANTHROPIC_API_KEY (above). Without it a built-in rule-based assistant answers.
